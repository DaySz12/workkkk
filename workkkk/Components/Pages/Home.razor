@page "/"
@using workkkk.Viewmodel
@using workkkk.Provider;
@inject OrderProvider orderProvider
@inject CustomerProivider customerProvider
@inject ProductProvider ProductProvider

<h3>Create Order</h3>

<div class="card p-4">

    <!-- Customer -->
    <div class="mb-3">
        <label>Customer</label>
        <select class="form-select" >
            <option value="0">-- Select Customer --</option>

            @foreach (var c in customers)
            {
                <option value="@c.Code">@c.Name</option>
            }
        </select>
    </div>

    <!-- Product -->
    <div class="mb-3">
        <label>Product</label>
        <select class="form-select" ">
            <option value="">-- Select Product --</option>

            @foreach (var p in products)
            {
                <option value="@p.Productcode">@p.Name (@p.Price)</option>
            }
        </select>
    </div>

    <!-- Qty -->
    <div class="mb-3">
        <label>Quantity</label>
        <input type="number"
               class="form-control"
               @bind="model.Qty"
               
               /> 
    </div>

    <!-- Total -->
    <div class="mb-3">
        <label>Total</label>
        <input class="form-control" value="@totalAmount" readonly />
    </div>

    <button class="btn btn-success" @onclick="SaveOrder">
        Save Order
    </button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }

</div>

@code {

    OrderView model = new();

    List<CustomerView> customers = new();
    List<ProductView> products = new();

    decimal selectedPrice = 0;
    decimal totalAmount = 0;
    private string productcode = "P001";
    private string code = "P001";
    string errorMessage = "";

    // ✅ โหลดตอนเปิดหน้า
    protected override async Task OnInitializedAsync()
    {
        customers = await customerProvider.CustomerlistById(code);
        products = await ProductProvider.ProductListById(productcode);


    } 

    // ✅ เลือกสินค้า
    // void OnProductChanged(ChangeEventArgs e)
    // {
    //     var productId = Convert.ToInt32(e.Value);

    //     var product = products.FirstOrDefault(x => x.Productcode == productId);

    //     if (product != null)
    //     {
    //         model.Productcode = product.id;
    //         selectedPrice = product.price;
    //     }

    //     CalculateTotal();
    // }

    // ✅ realtime total
    // void CalculateTotal()
    // {
    //     totalAmount = selectedPrice * model.qty;
    // }

    // ✅ Save
    @inject OrderProvider orderProvider
    async Task SaveOrder()
    {
        errorMessage = "";

        model.Status = "New";

        var response = await orderProvider.InsertOrder(model);

        if (response == null || !response.IsSuccessStatusCode)
        {
            errorMessage = response?.Message ?? "Save failed";
            return;
        }

        // reset form
        model = new OrderView();
        totalAmount = 0;
    }

}
